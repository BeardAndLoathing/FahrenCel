<?xml version="1.0" encoding="utf-8"?>
<!-- FahrenCel at 2x3. For home screens that can't resize widgets; it can still be resized where allowed. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_2x3_desc"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_preview_2x2"
    android:minWidth="110dp"
    android:minHeight="180dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:configure="com.fahrencel.app.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:widgetCategory="home_screen" />
